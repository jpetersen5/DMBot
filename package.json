{
  "name": "dmbot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://dmleaderboards.com",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "test": "vitest run",
    "scan:songs": "node --disable-warning=ExperimentalWarning src/scripts/scan_songs.ts",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "chart.js": "^4.6.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "scan-chart": "^8.0.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "sass": "^1.108.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@rolldown/plugin-babel": false
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "allowScripts": {
    "@parcel/watcher": false,
    "exifreader": false
  }
}
